{
    "manifest_version": 3,
    "author": "Jonathan Peppers",
    "name": "Merlinbot Extension",
    "description": "Merlinbot Extension for Azure DevOps",
    "version": "1.0",
    "action": {
        "default_popup": "merlinbot.html",
        "default_icon": "merlinbot.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [{
        "matches": ["<all_urls>"],
        "js": ["document_start.js"],
        "run_at": "document_idle"
    }]
}